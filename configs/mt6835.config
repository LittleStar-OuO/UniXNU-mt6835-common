# Shared kernel configuration of the MT6835 (Dimensity 6300 family).
# CONFIG_XNU_<NAME> becomes XNU_<NAME> in the kernel build.
#
# Only gates that are confirmed for the MediaTek platform are enabled here. Storage,
# display, input, GPU and power gates stay out until the TB365FC component and driver
# selection is recorded in porting.toml.

CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
# Architected timer PPIs (secure/phys/virt/hyp). The UEFI timer driver hands the
# physical timer to XNU; MT6835 runs the architected timer at 13 MHz.
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
